# CinePlus — variáveis de ambiente do Coolify
# Copie estes nomes para a aba "Environment Variables" do app no Coolify
# e preencha os valores. NÃO commite este arquivo preenchido.
#
# Banco do SITE (MySQL do docker-compose — NÃO é o banco do app NOFLIX).
# O host dentro da rede Docker é "db" (já está fixo no docker-compose.yml).
DB_HOST=db
DB_NAME=cineplus_site
DB_USER=cineplus
# Senha do usuário do banco do site (invente uma forte, só para o Coolify).
DB_PASS=troque-por-uma-senha-forte
# Senha do root do MySQL (invente outra forte, só para o Coolify).
DB_ROOT_PASSWORD=troque-por-uma-senha-forte-root
#
# URL do APP CinePlus (NOFLIX) — para onde o botão "Assinar agora" leva.
# O app fica no MESMO domínio, no caminho /app: https://cineplus.shop/app.
# NÃO coloque só cineplus.shop (sem /app), senão o botão volta para o site.
APP_URL=https://cineplus.shop/app
